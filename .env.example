# ── Launch gate ──────────────────────────────────────────────────────────────
# Controls whether the site is publicly distributable. Default (unset) = public.
#
# true (default) → public:     banner hidden, robots.txt allows all, indexable
# false          → lockdown: banner shown, robots.txt disallows all, noindex,nofollow
#
# Set to "false" only as an explicit safety switch to lock the site down.
NEXT_PUBLIC_PUBLIC_MODE=true

# ── Canonical site URL ───────────────────────────────────────────────────────
# Used for the sitemap. Defaults to https://stratovaquant.com when unset.
NEXT_PUBLIC_SITE_URL=https://stratovaquant.com

# ── Manual UPI checkout ──────────────────────────────────────────────────────
# Shown on /checkout/[paymentId] so subscribers know where to pay.
NEXT_PUBLIC_UPI_ID=yourupi@bank
NEXT_PUBLIC_SUPPORT_WHATSAPP=+91XXXXXXXXXX

# -- Supabase service role (server-only, admin tooling) --
# NEVER expose to the client. Used by lib/admin/* fetchers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
