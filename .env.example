# ── Launch gate ──────────────────────────────────────────────────────────────
# Controls whether the site is publicly distributable. Default (unset) = pre-launch.
#
# false / unset  → pre-launch: banner shown, robots.txt disallows all, noindex,nofollow
# true           → public:     banner hidden, robots.txt allows all, indexable
#
# ⚠️ The default is deliberately CLOSED. Only set this to "true" after the SEBI
# Research Analyst registration number in lib/site.ts has been replaced with the
# real issued number.
NEXT_PUBLIC_PUBLIC_MODE=false
